{
  "name": "protocol-dead-zone",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:motion": "tsc -p tools/tsconfig.motion.json && node .tmp/motion/tools/run-motion-tests.js",
    "desktop:start": "electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder --win --x64 --publish never",
    "test:desktop": "node tools/desktop-smoke.cjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.17.3",
    "@react-three/fiber": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "typescript": "~5.8.3",
    "vite": "^6.2.5",
    "vitest": "^3.1.1"
  },
  "main": "electron/main.cjs",
  "description": "PROTOCOL: DEAD ZONE — desktop test build"
}
